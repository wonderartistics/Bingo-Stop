{
  "appId": "com.bingostop.app",
  "appName": "Bingo Stop",
  "webDir": "www",
  "bundledWebRuntime": false,
  "backgroundColor": "#0b0d16",
  "android": {
    "backgroundColor": "#0b0d16"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3500,
      "launchAutoHide": true,
      "backgroundColor": "#0b0d16",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}
